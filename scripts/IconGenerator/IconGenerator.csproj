<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Ribbon icon generator (not part of the solution).
    Usage: run this project with the output folder as the only argument
    (see the README section "Ribbon icons" for the exact command).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
