<Project>
  <!--
    Shared build settings for every project in the repository.

    XML documentation: production projects generate an XML documentation file, which makes the
    compiler report undocumented public members (CS1591) and broken cref references (CS1574, CS1584).
    The XML files are also picked up by IDEs for IntelliSense. Test projects are excluded because
    their test method names already describe the scenario.
  -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('Tests'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Product version, stamped into every assembly. The installer (installer/DxfToRevit.iss) reads it
    from DxfToRevit.Addin.dll, so this is the single place to change the release version.
  -->
  <PropertyGroup>
    <Version>2.1.0</Version>
    <Product>DxfToRevit</Product>
    <Company>DxfToRevit</Company>
    <Copyright>Copyright (c) 2026 Soner Ayar</Copyright>
  </PropertyGroup>
</Project>
